modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Flutter Web"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Run Flutter Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd flutter_app && flutter run -d web-server --web-port 8080 --web-hostname 0.0.0.0 --no-pub"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "node server/index.js"]
build = ["bash", "-c", "npm run build"]

[userenv]

[userenv.shared]
VITE_FIREBASE_AUTH_DOMAIN = "heartsync-b4e9f.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "heartsync-b4e9f"
VITE_FIREBASE_STORAGE_BUCKET = "heartsync-b4e9f.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID = "324450946196"
VITE_FIREBASE_APP_ID = "1:324450946196:web:cc0d6675befd6a712eb881"
VITE_FIREBASE_MEASUREMENT_ID = "G-KELNLQ2YKY"
